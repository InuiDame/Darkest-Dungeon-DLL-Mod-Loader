#include <winres.h>
#include "Plugin.h"

1 VERSIONINFO
	FILEVERSION PLUGIN_VERSION_MAJOR, PLUGIN_VERSION_MINOR, PLUGIN_VERSION_PATCH, 0
	PRODUCTVERSION PLUGIN_VERSION_MAJOR, PLUGIN_VERSION_MINOR, PLUGIN_VERSION_PATCH, 0
	FILEFLAGSMASK 0x17L
#ifdef _DEBUG
	FILEFLAGS 0x1L
#else
	FILEFLAGS 0x0L
#endif
	FILEOS 0x4L
	FILETYPE 0x2L
	FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", PLUGIN_AUTHOR
			VALUE "FileDescription", PLUGIN_NAME
			VALUE "FileVersion", PLUGIN_VERSION_STRING
			VALUE "InternalName", PLUGIN_NAME
			VALUE "LegalCopyright", PLUGIN_LICENSE
			VALUE "ProductName", PLUGIN_NAME
			VALUE "ProductVersion", PLUGIN_VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
